{
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "dev": "npx @tailwindcss/cli -i ./src/css/global.css -o ./assets/css/global.css --watch",
    "build": "npx @tailwindcss/cli -i ./src/css/global.css -o ./assets/css/global.css --minify",
    "build:frontpage": "npx @tailwindcss/cli -i ./src/css/frontpage.css -o ./assets/css/frontpage.css --minify",
    "build:page": "npx @tailwindcss/cli -i ./src/css/page.css -o ./assets/css/page.css --minify"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.1": true
  }
}
